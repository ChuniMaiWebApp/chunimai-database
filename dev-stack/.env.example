# =============================================================================
# Supabase Local Setup - Environment Configuration Template
# =============================================================================
# Copy this file to .env and replace the placeholder values with your own
# Command: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL database credentials for the local Supabase instance

# Password for the PostgreSQL superuser (postgres)
# IMPORTANT: Use a strong password in production environments
POSTGRES_PASSWORD=your-super-secret-password

# Name of the default PostgreSQL database
# Default: postgres (recommended to keep this value)
POSTGRES_DB=postgres

# PostgreSQL superuser username
# Default: postgres (recommended to keep this value)
POSTGRES_USER=postgres

# -----------------------------------------------------------------------------
# Service Database Users
# -----------------------------------------------------------------------------
# Dedicated database user passwords for Supabase services
# These users are created by the init script with specific schema permissions

# Password for supabase_auth_admin user (Auth/GoTrue service)
# This user has full access to the auth schema
AUTH_DB_PASSWORD=auth-admin-password

# Password for supabase_storage_admin user (Storage API service)
# This user has full access to the storage schema
STORAGE_DB_PASSWORD=storage-admin-password

# Password for supabase_realtime_admin user (Realtime service)
# This user has access to realtime and _realtime schemas
REALTIME_DB_PASSWORD=realtime-admin-password

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# JSON Web Token secret used for signing and verifying authentication tokens

# JWT signing secret - MUST be at least 32 characters long
# Generate a secure random string: openssl rand -base64 32
# This secret is used by all authentication services
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# -----------------------------------------------------------------------------
# API Keys
# -----------------------------------------------------------------------------
# Supabase API keys for client authentication

# Anonymous key - used for public client access with row-level security
# This key has limited permissions and is safe to use in client-side code
# Generate using: scripts/generate_keys.py or use Supabase JWT generator
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Service role key - used for server-side operations with full database access
# IMPORTANT: Keep this secret! Never expose in client-side code
# This key bypasses row-level security policies
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# External URL for accessing the Supabase API through Kong Gateway

# Base URL for API access - used by clients to connect to your Supabase instance
# For local development: http://localhost:8095 (Kong trên host; trong container vẫn 8000)
# For production: https://your-domain.com
API_EXTERNAL_URL=http://localhost:8095

# -----------------------------------------------------------------------------
# Studio Configuration
# -----------------------------------------------------------------------------
# Supabase Studio web interface settings

# Port for accessing the Supabase Studio web UI
# Access Studio at: http://localhost:3000
# Change this if port 3000 is already in use on your system
STUDIO_PORT=3000
