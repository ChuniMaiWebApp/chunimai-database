# =============================================================================
# Credentials for the production data services (docker-compose.prod.yml).
#
#   cp .env.prod.example .env.prod   &&   nano .env.prod
#
# Read by Docker Compose only. The API reads chuni-backend/.env, and the
# password below has to match the one inside its DATABASE_URL.
#
# .env.prod is gitignored. Never commit a filled-in copy.
# =============================================================================

# Generate with: openssl rand -hex 24
# Hex, not base64: a `/` or `+` in the password has to be percent-encoded
# inside DATABASE_URL, and that trips people up every single time.
POSTGRES_PASSWORD=

POSTGRES_USER=postgres
POSTGRES_DB=postgres

# --- Studio (my-db.novaseele.com) --------------------------------------------
STUDIO_ORG_NAME=ChuniMai
STUDIO_PROJECT_NAME=chunimai
STUDIO_PUBLIC_URL=https://my-db.novaseele.com

# Optional. Studio only displays these on its API-keys page — nothing in
# production consumes them, because PostgREST and GoTrue are not running.
# Leave blank unless you want that page populated. To generate a matching set:
#   cd dev-stack && python scripts/generate_keys.py
ANON_KEY=
SERVICE_ROLE_KEY=
